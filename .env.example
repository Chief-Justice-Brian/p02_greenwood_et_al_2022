# This file serves as an example of what your .env file should look like.
# Copy it to a file called ".env" in the project root and edit as needed.
# Every variable here is OPTIONAL: settings.py provides working defaults,
# so an empty .env (or none at all) is fine for a standard run.
#
# No credentials are required for this project. All data sources
# (BIS, IMF, OECD, World Bank, JST MacroHistory, Harvard Dataverse)
# are free and require no API keys.

# Where pulled data and generated output are stored (relative paths are
# resolved against the project root).
# DATA_DIR=_data
# OUTPUT_DIR=_output

# Panel window. START_DATE matches the paper's sample start; END_DATE
# extends through the present for the R-Zone Monitor.
# START_DATE=1950-01-01
# END_DATE=2026-06-30
